@page "/facture/{Id:int}"
@rendermode InteractiveServer
@using InvoicingApp.Models
@inject IFactureService FactureService

<div class="fp-page-header">
    <div style="display:flex;align-items:center;gap:12px">
        <h1 class="fp-page-title fp-mono">Facture N°@Id</h1>
    </div>
    <div style="display:flex;gap:8px">
        <button class="fp-btn-outline" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Imprimer
        </button>
        <a href="/edit-facture/@Id" class="fp-btn-outline">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
        <a href="/factures" class="fp-btn-ghost">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
    </div>
</div>

@if (facture == null)
{
    <div class="fp-empty-state">
        <span class="fp-spinner"></span> Chargement…
    </div>
}
else
{
    <div class="fp-invoice-doc">

        <!-- Invoice header -->
        <div class="fp-invoice-header">
            <div>
                <div class="fp-company-name fp-grad">InvoicingApp</div>
                <div class="fp-company-info">Tunisie · contact@invoicingapp.tn</div>
            </div>
            <div style="text-align:right">
                <div class="fp-invoice-word">FACTURE</div>
                <div class="fp-mono fp-primary-text" style="font-weight:700;font-size:.9rem;margin-top:4px">#@facture.Id</div>
                <div class="fp-company-info" style="margin-top:12px">Date : @facture.Date.ToShortDateString()</div>
            </div>
        </div>

        <!-- Billed to -->
        <div class="fp-billed-to">
            <div class="fp-billed-label">Facturé à</div>
            <div style="font-weight:700">@facture.Client?.Nom</div>
            @if (!string.IsNullOrEmpty(facture.Client?.Adresse))
            {
                <div class="fp-company-info">@facture.Client.Adresse</div>
            }
            @if (!string.IsNullOrEmpty(facture.Client?.MatriculeFiscale))
            {
                <div class="fp-company-info fp-mono">MF : @facture.Client.MatriculeFiscale</div>
            }
        </div>

        <!-- Lines table -->
        <div style="overflow-x:auto;margin-bottom:24px">
            <table class="fp-table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th style="text-align:right">Qté</th>
                        <th style="text-align:right">PU HT (DT)</th>
                        <th style="text-align:right">TVA (%)</th>
                        <th style="text-align:right">Montant HT</th>
                        <th style="text-align:right">Montant TVA</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ligne in facture.Lignes)
                    {
                        <tr>
                            <td style="font-weight:500">@ligne.Produit?.Nom</td>
                            <td class="fp-mono" style="text-align:right">@ligne.Quantite</td>
                            <td class="fp-mono" style="text-align:right">@ligne.PrixUnitaireHT.ToString("F2")</td>
                            <td class="fp-mono" style="text-align:right">@(ligne.TauxTVA * 100)%</td>
                            <td class="fp-mono" style="text-align:right">@ligne.MontantHT.ToString("F2")</td>
                            <td class="fp-mono" style="text-align:right">@ligne.MontantTVA.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <div class="fp-totals-wrap">
            <div class="fp-totals-box">
                <div class="fp-total-row">
                    <span class="fp-muted">Total HT</span>
                    <span class="fp-mono">@facture.TotalHT.ToString("F2") DT</span>
                </div>
                <div class="fp-total-row">
                    <span class="fp-muted">Total TVA</span>
                    <span class="fp-mono">@facture.TotalTVA.ToString("F2") DT</span>
                </div>
                <div class="fp-total-row">
                    <span class="fp-muted">Timbre fiscal</span>
                    <span class="fp-mono">@facture.TimbreFiscal.ToString("F2") DT</span>
                </div>
                <div class="fp-total-final">
                    <span style="font-weight:700">Total TTC</span>
                    <span class="fp-total-big fp-grad">@facture.TotalTTC.ToString("F2") DT</span>
                </div>
            </div>
        </div>

        <div class="fp-invoice-footer-note">
            Merci pour votre confiance · Règlement par virement bancaire · Conformité fiscale tunisienne
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Facture? facture;

    protected override async Task OnInitializedAsync()
    {
        facture = await FactureService.GetFactureByIdAsync(Id);
    }
}
