@page "/produits"
@rendermode InteractiveServer
@using InvoicingApp.Models
@using Microsoft.JSInterop
@inject IProduitService ProduitService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="fp-page-header">
    <div>
        <h1 class="fp-page-title">Catalogue produits</h1>
        <p class="fp-page-sub">@produits.Count article(s) enregistré(s)</p>
    </div>
    <div style="display:flex;gap:8px">
        <button class="fp-btn-ghost" @onclick="ToggleViewMode" title="Changer de vue">
            <i class="bi bi-@(viewMode == "cards" ? "table" : "grid-3x3-gap-fill")"></i>
            @(viewMode == "cards" ? "Vue tableau" : "Vue cartes")
        </button>
        <a href="/produit-edit" class="fp-btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Nouveau produit
        </a>
    </div>
</div>

@if (produits == null || !produits.Any())
{
    <div class="fp-empty-state">
        <i class="bi bi-box-seam fs-1 mb-3 d-block" style="opacity:.35"></i>
        Aucun produit enregistré.
    </div>
}
else if (viewMode == "cards")
{
    <div class="fp-cards-grid">
        @foreach (var produit in produits)
        {
            <div class="fp-client-card">
                <div class="fp-client-top">
                    <div class="fp-client-avatar" style="background:linear-gradient(135deg,hsl(190 90% 36%),hsl(200 90% 50%))">
                        <i class="bi bi-box-seam-fill" style="font-size:.9rem"></i>
                    </div>
                    <div style="flex:1;min-width:0">
                        <div style="font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@produit.Nom</div>
                        <div class="fp-mono fp-muted" style="font-size:.72rem">TVA : @(produit.TauxTVA * 100)%</div>
                    </div>
                    <div style="display:flex;gap:4px;flex-shrink:0">
                        <a href="/produit-edit/@produit.Id" class="fp-icon-btn" title="Modifier">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <button class="fp-icon-btn danger" title="Supprimer" @onclick="() => Delete(produit.Id)">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </div>
                <div class="fp-client-details">
                    <div class="fp-client-detail-row">
                        <i class="bi bi-cash-stack"></i>
                        <span>Prix HT : <strong class="fp-mono">@produit.PrixHT.ToString("F2") DT</strong></span>
                    </div>
                    <div class="fp-client-detail-row">
                        <i class="bi bi-tag-fill"></i>
                        <span class="fp-badge-green">TTC : @((produit.PrixHT * (1 + produit.TauxTVA)).ToString("F2")) DT</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="fp-table-wrap">
        <div style="overflow-x:auto">
            <table class="fp-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th style="text-align:right">Prix HT</th>
                        <th style="text-align:right">TVA</th>
                        <th style="text-align:right">TTC</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in produits)
                    {
                        <tr class="fp-tr-hover">
                            <td style="font-weight:600">@p.Nom</td>
                            <td class="fp-mono" style="text-align:right">@p.PrixHT.ToString("F2") DT</td>
                            <td class="fp-mono" style="text-align:right">@(p.TauxTVA * 100)%</td>
                            <td class="fp-mono" style="text-align:right;font-weight:700">@((p.PrixHT * (1 + p.TauxTVA)).ToString("F2")) DT</td>
                            <td style="text-align:right">
                                <div class="fp-actions">
                                    <a href="/produit-edit/@p.Id" class="fp-icon-btn" title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button class="fp-icon-btn danger" @onclick="() => Delete(p.Id)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Produit> produits = new();
    private string viewMode = "cards";

    protected override async Task OnInitializedAsync()
    {
        await LoadProduits();
    }

    private async Task LoadProduits()
    {
        produits = await ProduitService.GetProduitsAsync();
    }

    private async Task Delete(int id)
    {
        if (await JS.InvokeAsync<bool>("window.confirm", "Supprimer ce produit ?"))
        {
            await ProduitService.DeleteProduitAsync(id);
            await LoadProduits();
            StateHasChanged();
        }
    }

    private void ToggleViewMode()
    {
        viewMode = viewMode == "cards" ? "table" : "cards";
    }
}
