@using InvoicingApp.Components.Layout
@layout EmptyLayout
@page "/login"
@rendermode InteractiveServer
@using InvoicingApp.Services
@inject AuthService Auth
@inject NavigationManager Nav

<div class="fp-login-shell">
    <!-- Left brand panel -->
    <div class="fp-login-brand">
        <div class="fp-login-brand-overlay"></div>

        <div class="fp-login-brand-header">
            <div class="fp-login-logo-box">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <div>
                <div class="fp-login-logo-name">FacturaPro</div>
                <div class="fp-login-logo-sub">Facturation tunisienne · .NET</div>
            </div>
        </div>

        <div class="fp-login-brand-body">
            <div class="fp-login-badge">
                <i class="bi bi-stars"></i> Édition Prototype
            </div>
            <h1 class="fp-login-headline">
                Une facturation moderne, conforme et instantanée.
            </h1>
            <p class="fp-login-tagline">
                TVA tunisienne, timbre fiscal, suivi en temps réel et tableau de bord analytique.
            </p>
            @foreach (var feature in new[] {
                "Conformité fiscale tunisienne",
                "Tableau de bord temps réel",
                "Export PDF prêt à imprimer",
                "Architecture modulaire"
            })
            {
                <div class="fp-login-feature">
                    <span class="fp-login-check">✓</span>
                    @feature
                </div>
            }
        </div>

        <div class="fp-login-brand-footer">
            © @DateTime.Now.Year FacturaPro Tunisie
        </div>
    </div>

    <!-- Right form panel -->
    <div class="fp-login-form-panel">
        <form class="fp-login-card" @onsubmit="HandleSubmit" @onsubmit:preventDefault>
            <h2 class="fp-login-title">Bon retour 👋</h2>
            <p class="fp-login-subtitle">Connectez-vous pour accéder à votre espace.</p>

            <div class="fp-login-field">
                <label class="fp-login-label">Email</label>
                <div class="fp-login-input-wrap">
                    <i class="bi bi-envelope fp-login-input-icon"></i>
                    <input type="email" @bind="email" @bind:event="oninput" class="fp-login-input" placeholder="admin@facturapro.tn" required />
                </div>
            </div>

            <div class="fp-login-field">
                <label class="fp-login-label">Mot de passe</label>
                <div class="fp-login-input-wrap">
                    <i class="bi bi-lock fp-login-input-icon"></i>
                    <input type="password" @bind="password" @bind:event="oninput" class="fp-login-input" placeholder="••••••••" required />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="fp-login-error">
                    <i class="bi bi-exclamation-circle me-2"></i>@error
                </div>
            }

            <button type="submit" class="fp-login-btn">
                <span>Se connecter</span>
                <i class="bi bi-arrow-right"></i>
            </button>

            <p class="fp-login-hint">
                Entrez vos identifiants administrateur pour accéder au tableau de bord.
            </p>
        </form>
    </div>
</div>

<style>
    /* ── Shell ──────────────────────────────────────────────── */
    .fp-login-shell {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 100vh;
        width: 100%;
        font-family: 'Sora', 'Segoe UI', system-ui, sans-serif;
    }

    /* ── Left brand panel ───────────────────────────────────── */
    .fp-login-brand {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 3rem;
        overflow: hidden;
        background: linear-gradient(135deg, hsl(160 84% 38%), hsl(190 90% 44%));
    }

    .fp-login-brand-overlay {
        position: absolute;
        inset: 0;
        opacity: 0.25;
        background-image:
            radial-gradient(circle at 20% 20%, white 0, transparent 40%),
            radial-gradient(circle at 80% 80%, white 0, transparent 40%);
        pointer-events: none;
    }

    .fp-login-brand-header {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .fp-login-logo-box {
        height: 48px;
        width: 48px;
        border-radius: 14px;
        background: rgba(255,255,255,0.22);
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        color: white;
        flex-shrink: 0;
        backdrop-filter: blur(8px);
    }

    .fp-login-logo-name {
        font-size: 1.35rem;
        font-weight: 800;
        color: white;
        letter-spacing: -0.02em;
    }

    .fp-login-logo-sub {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.8);
        margin-top: 1px;
    }

    .fp-login-brand-body {
        position: relative;
        z-index: 1;
        color: white;
        max-width: 420px;
    }

    .fp-login-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        background: rgba(255,255,255,0.18);
        padding: 4px 14px;
        font-size: 0.72rem;
        font-weight: 700;
        margin-bottom: 20px;
        backdrop-filter: blur(4px);
    }

    .fp-login-headline {
        font-size: 2.1rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: 14px;
        color: white;
    }

    .fp-login-tagline {
        font-size: 0.88rem;
        opacity: 0.9;
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .fp-login-feature {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        font-size: 0.88rem;
    }

    .fp-login-check {
        height: 24px;
        width: 24px;
        border-radius: 999px;
        background: rgba(255,255,255,0.22);
        display: grid;
        place-items: center;
        font-size: 0.7rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .fp-login-brand-footer {
        position: relative;
        z-index: 1;
        color: rgba(255,255,255,0.65);
        font-size: 0.7rem;
    }

    /* ── Right form panel ───────────────────────────────────── */
    .fp-login-form-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        background: hsl(222 47% 6%);
        background-image:
            radial-gradient(ellipse 80% 60% at 80% 0%, hsl(160 84% 45% / 0.12) 0%, transparent 60%),
            radial-gradient(ellipse 60% 70% at 20% 100%, hsl(190 90% 50% / 0.08) 0%, transparent 60%);
    }

    .fp-login-card {
        width: 100%;
        max-width: 420px;
        background: hsl(222 40% 9% / 0.7);
        border: 1px solid hsl(210 40% 96% / 0.08);
        backdrop-filter: blur(20px) saturate(160%);
        border-radius: 1rem;
        padding: 2.25rem;
        animation: fpFadeUp 0.4s ease;
    }

    @@keyframes fpFadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .fp-login-title {
        font-size: 1.8rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: hsl(210 40% 96%);
        margin-bottom: 4px;
    }

    .fp-login-subtitle {
        font-size: 0.84rem;
        color: hsl(215 20% 55%);
        margin-bottom: 28px;
    }

    .fp-login-field {
        margin-bottom: 18px;
    }

    .fp-login-label {
        display: block;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: hsl(215 20% 55%);
        margin-bottom: 6px;
    }

    .fp-login-input-wrap {
        position: relative;
    }

    .fp-login-input-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: hsl(215 20% 55%);
        font-size: 0.95rem;
        pointer-events: none;
    }

    .fp-login-input {
        width: 100%;
        height: 44px;
        padding: 0 14px 0 40px;
        border-radius: 10px;
        background: hsl(217 30% 15% / 0.6);
        border: 1px solid hsl(217 30% 18%);
        color: hsl(210 40% 96%);
        font-size: 0.88rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.15s, background 0.15s;
    }

    .fp-login-input::placeholder {
        color: hsl(215 20% 40%);
    }

    .fp-login-input:focus {
        border-color: hsl(160 84% 45% / 0.6);
        background: hsl(217 30% 15% / 0.9);
    }

    .fp-login-error {
        background: hsl(0 75% 60% / 0.12);
        border: 1px solid hsl(0 75% 60% / 0.3);
        color: hsl(0 75% 70%);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.82rem;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
    }

    .fp-login-btn {
        width: 100%;
        height: 46px;
        margin-top: 8px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, hsl(160 84% 38%), hsl(190 90% 44%));
        color: white;
        font-weight: 700;
        font-size: 0.95rem;
        font-family: inherit;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 0 40px hsl(160 84% 45% / 0.25);
        transition: opacity 0.15s, transform 0.15s;
    }

    .fp-login-btn:hover {
        opacity: 0.92;
        transform: translateY(-1px);
    }

    .fp-login-btn:active {
        transform: translateY(0);
    }

    .fp-login-hint {
        text-align: center;
        font-size: 0.72rem;
        color: hsl(215 20% 40%);
        margin-top: 16px;
        line-height: 1.5;
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @@media (max-width: 768px) {
        .fp-login-shell {
            grid-template-columns: 1fr;
        }
        .fp-login-brand {
            display: none;
        }
        .fp-login-form-panel {
            background: hsl(222 47% 6%);
        }
    }
</style>

@code {
    private string email = "";
    private string password = "";
    private string error = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Veuillez remplir tous les champs.";
            return;
        }

        if (Auth.Login(email, password))
        {
            Nav.NavigateTo("/dashboard");
        }
        else
        {
            error = "Email ou mot de passe incorrect.";
        }
    }

    protected override void OnInitialized()
    {
        if (Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/dashboard");
        }
    }
}
